# Server-only URL for the backend API used by Next.js route handlers.
# Do not use a NEXT_PUBLIC_ prefix; browsers must not receive this value.
BACKEND_API_URL=http://localhost:4000/api/v1

# Optional trusted public frontend origin for reverse-proxy deployments.
# Set this only on the frontend server, for example in Coolify (no trailing slash).
# Leave unset in local development and Vercel unless their canonical origin is fixed.
# AURA_PUBLIC_ORIGIN=https://aura.example.com

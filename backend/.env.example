# Server configuration
PORT=4000
NODE_ENV=development
API_VERSION=v1

# Database connection. Use a local or Supabase PostgreSQL URL.
DATABASE_URL=postgresql://username:password@localhost:5432/aura

# Authentication. Generate a long, random value for each environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser and deployment URLs
FRONTEND_URL=http://localhost:3000
# VERCEL_URL=your-preview-deployment.vercel.app

# Shopify OAuth. Get these from your Shopify app configuration.
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_REDIRECT_URI=http://localhost:4000/api/v1/integrations/shopify/callback

# Development-only metrics seed script. Never target production data.
SEED_BRAND_ID=replace-with-development-brand-uuid
SEED_INTEGRATION_ID=replace-with-development-integration-uuid
ALLOW_METRICS_SEED=false
